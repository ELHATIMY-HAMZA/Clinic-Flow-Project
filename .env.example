# ─── Database ──────────────────────────────────────────────────────────────
# Supabase: Dashboard → Connect → "Session pooler" (IPv4-compatible), e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Local docker (docker compose --profile local): 
#   postgresql://clinicflow:clinicflow@localhost:5432/clinicflow   (from host)
#   postgresql://clinicflow:clinicflow@db:5432/clinicflow          (from api container)
DATABASE_URL=postgresql://clinicflow:clinicflow@localhost:5432/clinicflow
# true for Supabase, false for local Postgres
DATABASE_SSL=false

# ─── API ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# At least 32 random characters — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Timezone used to compute "today" (dashboard / date filters)
APP_TIMEZONE=Africa/Casablanca
LOG_LEVEL=info
